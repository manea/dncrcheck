[Unit]
Description=DNCRCheck UAE Telemarketing & Do-Not-Call Registry (CD 56 & 57/2024) Auditor
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dncrcheck
EnvironmentFile=/etc/dncrcheck/.env
ExecStart=/usr/bin/node --no-warnings /opt/dncrcheck/server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
